{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Visitor Verdict signal registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "registryVersion",
    "detectorVersion",
    "description",
    "signals"
  ],
  "properties": {
    "$schema": {
      "const": "./registry.schema.json"
    },
    "registryVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "detectorVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "code",
          "family",
          "check",
          "weight",
          "hardness",
          "status",
          "lastChecked",
          "sources",
          "verification",
          "falsePositives"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "retirementReason": {
            "type": "string",
            "minLength": 1
          },
          "token": {
            "type": "string",
            "minLength": 1
          },
          "elementId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "code",
              "ua-token",
              "element-id",
              "information"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{1,3}$"
          },
          "family": {
            "enum": [
              "environment",
              "behaviour",
              "declaration",
              "carry-over"
            ]
          },
          "weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "hardness": {
            "enum": [
              "hard",
              "declared",
              "inherited",
              "soft",
              "debug",
              "direct-suspicious",
              "informational"
            ]
          },
          "status": {
            "enum": [
              "experimental",
              "validated",
              "retired"
            ]
          },
          "lastChecked": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https://[^ ]+$"
            }
          },
          "falsePositives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "product",
                "versions",
                "result",
                "kind",
                "source"
              ],
              "properties": {
                "product": {
                  "type": "string",
                  "minLength": 1
                },
                "versions": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "code-review",
                    "field-observation",
                    "documentation",
                    "source-observation"
                  ]
                },
                "source": {
                  "type": "string",
                  "pattern": "^https://[^ ]+$"
                }
              }
            }
          },
          "scoringFamily": {
            "enum": [
              "geometry",
              "language",
              "plugins",
              "graphics",
              "chrome",
              "permissions",
              "interaction",
              "navigation",
              "pointer",
              "worker",
              "automationEnvironment"
            ]
          },
          "parent": {
            "enum": [
              "body",
              "documentElement"
            ]
          },
          "operator": {
            "enum": [
              "anthropic",
              "openai"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "ua-token"
                }
              }
            },
            "then": {
              "required": [
                "token"
              ],
              "properties": {
                "token": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "element-id"
                }
              }
            },
            "then": {
              "required": [
                "elementId",
                "parent",
                "operator"
              ],
              "properties": {
                "elementId": {
                  "type": "string",
                  "minLength": 1
                },
                "parent": {
                  "enum": [
                    "body",
                    "documentElement"
                  ]
                },
                "operator": {
                  "enum": [
                    "anthropic",
                    "openai"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "retired"
                }
              }
            },
            "then": {
              "required": [
                "retirementReason"
              ],
              "properties": {
                "retirementReason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
