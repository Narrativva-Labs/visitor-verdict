{
  "name": "visitor-verdict-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "build": "node node_modules/typescript/bin/tsc",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "npm run build && npm run test:types && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "test:types": "node node_modules/typescript/bin/tsc --noEmit --strict --target ES2022 --module NodeNext --lib ES2022 test/api-types.ts"
  },
  "dependencies": {
    "structured-headers": "2.1.1"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.20.1",
    "prettier": "3.3.3"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ]
}
